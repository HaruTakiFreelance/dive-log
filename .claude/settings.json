{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|TodoWrite",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/todo-reminder.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
